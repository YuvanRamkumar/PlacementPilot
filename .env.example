# LLM provider (set to "fake" for tests, "groq" or "openai_compat" for real calls)
LLM_PROVIDER=groq

# App model (small/fast) — check https://console.groq.com/docs/models for current IDs
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-20b
# How long gpt-oss models think before answering: low is fastest (low | medium | high)
LLM_REASONING_EFFORT=low

# Judge model (larger, used in evals)
JUDGE_MODEL=openai/gpt-oss-120b

# Opt out of DeepEval cloud telemetry (no Confident AI account needed)
DEEPEVAL_TELEMETRY_OPT_OUT=YES

# Optional: Gemini via AI Studio OpenAI-compatible endpoint
# JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# JUDGE_API_KEY=your_gemini_api_key_here
